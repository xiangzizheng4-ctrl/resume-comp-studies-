<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kobe Bryant | Legacy Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>

:root{
    --purple:#552583;
    --gold:#FDB927;
    --black:#0f0f0f;
    --bg:#f5f7fb;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Poppins',sans-serif;
    background:var(--bg);
    color:#222;
    line-height:1.8;
    perspective:1200px;
    overflow-x:hidden;
}

/* HERO */
.hero{
    min-height:100vh;
    background:
    linear-gradient(rgba(0,0,0,.72),rgba(0,0,0,.72)),
    url('https://images.unsplash.com/photo-1519861531473-9200262188bf?q=80&w=1920&auto=format&fit=crop');
    background-size:cover;
    background-position:center;
    display:flex;
    align-items:center;
    padding:60px;
    position:relative;
}

.hero::after{
    content:"";
    position:absolute;
    inset:0;
    background:radial-gradient(circle at var(--x,50%) var(--y,50%), rgba(253,185,39,.25), transparent 40%);
    pointer-events:none;
}

.hero-content{
    max-width:1300px;
    width:100%;
    margin:auto;
    display:flex;
    justify-content:space-between;
    gap:60px;
    position:relative;
    z-index:2;
}

.hero-left{
    flex:1;
    color:white;
}

.badge{
    display:inline-block;
    background:var(--gold);
    color:black;
    padding:8px 18px;
    border-radius:30px;
    font-weight:700;
    margin-bottom:20px;
}

.hero h1{
    font-size:4.5rem;
}

.subtitle{
    color:var(--gold);
    margin-bottom:15px;
}

.contact{
    opacity:.9;
    margin-bottom:20px;
}

.hero-image{
    width:340px;
    border-radius:20px;
    overflow:hidden;
    border:5px solid var(--gold);
    box-shadow:0 25px 60px rgba(0,0,0,.5);
    transform:rotateY(-10deg) rotateX(5deg);
    transition:.4s;
}

.hero-image:hover{
    transform:rotateY(0deg) rotateX(0deg) scale(1.08);
}

.hero-image img{
    width:100%;
}

/* STATS */
.stats{
    margin-top:25px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.stat{
    background:rgba(255,255,255,.12);
    backdrop-filter:blur(10px);
    padding:18px;
    border-radius:14px;
    text-align:center;
    transition:.4s;
}

.stat:hover{
    transform:translateY(-10px) rotateX(10deg) scale(1.05);
    box-shadow:0 20px 40px rgba(0,0,0,.3);
}

/* CONTAINER */
.container{
    max-width:1200px;
    margin:auto;
    padding:80px 25px;
}

.section{
    margin-bottom:60px;
}

.section-title{
    font-size:1.9rem;
    color:var(--purple);
    margin-bottom:20px;
}

/* CARD */
.card{
    background:white;
    padding:30px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.08);
    transition:.4s;
}

.card:hover{
    transform:translateY(-15px) rotateX(5deg) rotateY(-5deg);
}

/* LIST HOVER BLOCKS */
.block{
    background:white;
    padding:12px 15px;
    margin:8px 0;
    border-radius:10px;
    transition:.3s;
}

.block:hover{
    transform:translateX(10px);
    background:linear-gradient(90deg,var(--purple),#6d32a8);
    color:white;
}

/* AWARDS */
.awards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:15px;
}

.award{
    background:white;
    padding:20px;
    border-radius:15px;
    transition:.4s;
}

.award:hover{
    transform:translateY(-10px) scale(1.05);
    background:var(--purple);
    color:white;
}

/* SKILLS */
.skills{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.skill{
    background:var(--purple);
    color:white;
    padding:10px 16px;
    border-radius:999px;
    transition:.3s;
}

.skill:hover{
    transform:scale(1.1) translateY(-5px);
}

/* FOOTER */
footer{
    background:var(--black);
    color:white;
    text-align:center;
    padding:70px 20px;
}

footer blockquote{
    color:var(--gold);
    font-size:1.4rem;
}

/* MOBILE */
@media(max-width:900px){
.hero-content{flex-direction:column-reverse;text-align:center;}
.hero h1{font-size:2.8rem;}
.stats{grid-template-columns:repeat(2,1fr);}
.hero-image{width:260px;}
}

</style>
</head>

<body>

<!-- HERO -->
<section class="hero">
<div class="hero-content">

<div class="hero-left">

<span class="badge">NBA LEGEND</span>

<h1>Kobe Bryant</h1>

<div class="subtitle">
5× NBA Champion • Hall of Famer • Entrepreneur • Oscar Winner
