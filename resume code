</div>
</div>
</section>

<!-- OFF COURT -->
<section class="section">
<h2 class="section-title">Off-Court Achievements</h2>
<div class="card">

<div class="block">Founder, Kobe Inc.</div>
<div class="block">Founder, Granity Studios</div>
